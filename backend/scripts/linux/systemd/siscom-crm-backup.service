[Unit]
Description=SISCOM CRM sao luu PostgreSQL (pg_dump -Fc + age)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/siscom-crm/current/backend/scripts/linux/backup-db.sh
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /var/backups (cha) chu khong liet ke rieng tung thu muc: ProtectSystem=strict tao MOI duong dan ReadWritePaths thanh mot mount bind rieng,
# ma lien ket cung (ln) giua hai mount tra ve EXDEV => backup_pull_sync (siscom-crm -> siscom-crm-pull) hong. Cung 1 mount thi ln chay duoc.
ReadWritePaths=/var/backups
ReadOnlyPaths=/etc/siscom-crm /opt/siscom-crm
UMask=0077
