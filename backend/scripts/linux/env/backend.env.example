# MAU - /etc/siscom-crm/backend.env (root:root, chmod 600). KHONG commit gia tri that.
# create-db.sh <db> env se SINH file that voi mat khau ngau nhien; file nay chi de doc/doi chieu.
# NODE_ENV, HOST, PORT, TRUST_PROXY, COOKIE_SECURE da dat co dinh trong unit siscom-crm-backend.service
# (NODE_ENV=production, HOST=127.0.0.1, PORT=3000, TRUST_PROXY=loopback, COOKIE_SECURE=true, EXPORT_GAP_LOG_DIR=/var/log/siscom-crm/export-gap).
DATABASE_URL=postgresql://siscom_app:CHANGE_ME@127.0.0.1:5432/siscom_crm_staging
AUTH_DATABASE_URL=postgresql://siscom_auth:CHANGE_ME@127.0.0.1:5432/siscom_crm_staging
CORS_ORIGINS=https://crm.example.vn
AUTH_ALLOWED_ORIGINS=https://crm.example.vn
LOG_LEVEL=log
SESSION_IDLE_MINUTES=480
SESSION_ABS_HOURS=12
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_SOURCE=30
LOGIN_MAX_PER_IDENTIFIER=5
LOGIN_LOCK_AFTER_FAILURES=5
LOGIN_LOCK_MINUTES=15
# KHONG dat MIGRATE_DATABASE_URL o day (chi nam trong /etc/siscom-crm/migrate.env, root 600, cho deploy/backup/CLI).
