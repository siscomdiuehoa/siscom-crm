# Mau cau hinh Vite cho SISCOM CRM web (KHONG chua bi mat). Sao chep thanh .env.local (bi ignore) de chay demo noi backend that.
# Mac dinh (khong co file nay) = demo localStorage, khong goi mang.
# Dang nhap that bang phien cookie (backend PR #167) + Customer API that, cung origin qua Vite proxy /api -> http://127.0.0.1:3000:
VITE_CRM_AUTH_ENABLED=true
VITE_CRM_API_ENABLED=true
VITE_CRM_API_BASE=/api/v1
# Dich proxy khi backend chay o dia chi khac (chi dev server):
# VITE_DEV_API_TARGET=http://127.0.0.1:3000
